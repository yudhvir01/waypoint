# Bakes a Supabase project into the build so a deployment — and every
# device that opens it — connects automatically, with no per-device
# "paste your project ref and anon key" step. Optional: leave both unset
# to ship a build where "Use your own Supabase project" is the only
# Supabase path, and everyone brings their own.
#
# The anon key is safe to expose here — Supabase ships it in every
# client's JS bundle by design. Row-level security (supabase/setup.sql)
# is what actually restricts access, not keeping this key secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google sign-in (Drive backend). The client ID is public by design — it
# identifies the app to Google, the same way the Supabase anon key
# identifies the project above. The client *secret* is NOT an env var
# here: it lives only as a Supabase secret on whichever project runs
# supabase/functions/google-token (see that function's header comment),
# since it must never reach the browser.
VITE_GOOGLE_CLIENT_ID=
# The deployed URL of supabase/functions/google-token, e.g.
# https://<project-ref>.supabase.co/functions/v1/google-token
VITE_GOOGLE_TOKEN_RELAY_URL=
# Required by the iOS/Android app. Use the production HTTPS callback
# associated with the apps as a Universal Link / Android App Link, and
# register the exact same URI in Google Cloud, for example:
# https://waypoint.example.com/auth/google/callback
VITE_GOOGLE_REDIRECT_URI=

# Native (Android/iOS) builds and over-the-air bundles are built locally, so
# they need these same values in .env.capacitor.local (git-ignored) or the
# app ships without the default project and without Google sign-in. See
# docs/mobile.md. VITE_UPDATE_BASE_URL is the site the apps check for updates.
VITE_UPDATE_BASE_URL=
